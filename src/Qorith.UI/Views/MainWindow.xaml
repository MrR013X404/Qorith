<Window x:Class="Qorith.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qorith - Music Player"
        Width="800"
        Height="600"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e"
        Foreground="#ffffff"
        ResizeMode="CanResize">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <!-- Sidebar -->
            <StackPanel Grid.Column="0" Background="#2d2d2d" Margin="0,0,10,0" Padding="10">
                <TextBlock Text="Library" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" />
                <Button Content="All Songs" Padding="10,8" Margin="0,0,0,5" Background="#0066cc" Foreground="white" />
                <Button Content="Playlists" Padding="10,8" Margin="0,0,0,5" Background="#0066cc" Foreground="white" />
                <Button Content="Favorites" Padding="10,8" Margin="0,0,0,5" Background="#0066cc" Foreground="white" />
                <Button Content="Artists" Padding="10,8" Margin="0,0,0,5" Background="#0066cc" Foreground="white" />
                <Button Content="Albums" Padding="10,8" Margin="0,0,0,5" Background="#0066cc" Foreground="white" />
                <Button Content="Genres" Padding="10,8" Margin="0,0,0,5" Background="#0066cc" Foreground="white" />
            </StackPanel>
            
            <!-- Main Content -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Now Playing" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />
                <TextBlock Text="No song selected" FontSize="14" Foreground="#999999" />
            </StackPanel>
        </Grid>
        
        <!-- Progress Bar -->
        <StackPanel Grid.Row="1" Margin="10,0,10,10">
            <ProgressBar Height="4" Background="#2d2d2d" Foreground="#0066cc" />
            <Grid Margin="0,5,0,0">
                <TextBlock Text="0:00" HorizontalAlignment="Left" />
                <TextBlock Text="0:00" HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>
        
        <!-- Playback Controls -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10" Height="50">
            <Button Content="⏮" Width="40" Height="40" Margin="5" FontSize="18" />
            <Button Content="⏯" Width="40" Height="40" Margin="5" FontSize="18" Background="#0066cc" Foreground="white" />
            <Button Content="⏭" Width="40" Height="40" Margin="5" FontSize="18" />
            <Slider Width="100" Margin="15,0" VerticalAlignment="Center" />
            <TextBlock Text="100%" VerticalAlignment="Center" Margin="10,0" />
        </StackPanel>
    </Grid>
</Window>
