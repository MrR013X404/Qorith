<Window x:Class="Qorith.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qorith - Music Player"
        Width="900"
        Height="650"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e"
        Foreground="#ffffff"
        ResizeMode="CanResize"
        MinWidth="600"
        MinHeight="400">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Menu/Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#2d2d2d" Padding="10" Height="50">
            <Button Content="📁 Open Folder" Padding="15,10" Margin="5,0" Background="#0066cc" Foreground="white" Command="{Binding BrowseFolderCommand}" />
            <TextBlock Text="|" Foreground="#666666" Margin="10,0" VerticalAlignment="Center" />
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="10,0,5,0" />
            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="150" Padding="8" Background="#333333" Foreground="#ffffff" />
        </StackPanel>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <!-- Sidebar Navigation -->
            <StackPanel Grid.Column="0" Background="#2d2d2d" Margin="0,0,10,0" Padding="10">
                <TextBlock Text="Library" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" />
                <Button Content="🎵 All Songs" Padding="10,8" Margin="0,0,0,8" Background="#0066cc" Foreground="white" Style="{StaticResource ButtonStyle}" />
                <Button Content="❤️ Favorites" Padding="10,8" Margin="0,0,0,8" Background="#0066cc" Foreground="white" Style="{StaticResource ButtonStyle}" />
                <Button Content="📋 Playlists" Padding="10,8" Margin="0,0,0,8" Background="#0066cc" Foreground="white" Style="{StaticResource ButtonStyle}" />
                <Button Content="🎤 Artists" Padding="10,8" Margin="0,0,0,8" Background="#0066cc" Foreground="white" Style="{StaticResource ButtonStyle}" />
                <Button Content="💿 Albums" Padding="10,8" Margin="0,0,0,8" Background="#0066cc" Foreground="white" Style="{StaticResource ButtonStyle}" />
            </StackPanel>
            
            <!-- Songs List -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Songs" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />
                <DataGrid ItemsSource="{Binding Songs}" Background="#2d2d2d" Foreground="#ffffff" BorderThickness="0" RowBackground="#1e1e1e" AlternatingRowBackground="#2a2a2a">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="150" />
                        <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="80" />
                        <DataGridTemplateColumn Header="Action" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="▶" Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.PlayCommand}" CommandParameter="{Binding}" Width="40" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
        
        <!-- Now Playing Info -->
        <StackPanel Grid.Row="2" Background="#2d2d2d" Padding="15" Margin="10,0,10,10">
            <TextBlock Text="Now Playing" FontSize="12" Foreground="#999999" Margin="0,0,0,5" />
            <TextBlock Text="{Binding CurrentSong.Title, StringFormat='Title: {0}'}" FontSize="14" FontWeight="Bold" />
            <TextBlock Text="{Binding CurrentSong.Artist, StringFormat='Artist: {0}'}" FontSize="12" Foreground="#cccccc" />
        </StackPanel>
        
        <!-- Progress Bar -->
        <StackPanel Grid.Row="2" Margin="10,0,10,0" VerticalAlignment="Bottom" Padding="0,5">
            <Slider Value="{Binding CurrentPosition.TotalSeconds}" Maximum="{Binding Duration.TotalSeconds}" Background="#2d2d2d" Foreground="#0066cc" Height="4" />
            <Grid Margin="0,5,0,0">
                <TextBlock Text="{Binding CurrentPosition, StringFormat='hh\\:mm\\:ss'}" HorizontalAlignment="Left" FontSize="11" />
                <TextBlock Text="{Binding Duration, StringFormat='hh\\:mm\\:ss'}" HorizontalAlignment="Right" FontSize="11" />
            </Grid>
        </StackPanel>
        
        <!-- Playback Controls -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Background="#2d2d2d" Padding="10" Height="60">
            <Button Content="⏮" Width="45" Height="45" Margin="5" FontSize="20" Command="{Binding PreviousCommand}" />
            <Button Content="{Binding IsPlaying, StringFormat='▶|⏸'}" Width="55" Height="45" Margin="5" FontSize="20" Background="#0066cc" Foreground="white" />
            <Button Content="⏭" Width="45" Height="45" Margin="5" FontSize="20" Command="{Binding NextCommand}" />
            
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0" />
            
            <Button Content="🔁" Width="45" Height="45" Margin="5" FontSize="18" Command="{Binding ToggleRepeatCommand}" />
            <Button Content="🔀" Width="45" Height="45" Margin="5" FontSize="18" Command="{Binding ToggleShuffleCommand}" />
            
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0" />
            
            <TextBlock Text="🔊" VerticalAlignment="Center" Margin="10,0,5,0" />
            <Slider Width="100" Value="{Binding Volume}" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="5,0" />
        </StackPanel>
    </Grid>
    
    <Window.Resources>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0066cc" />
            <Setter Property="Foreground" Value="white" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0052a3" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
</Window>
